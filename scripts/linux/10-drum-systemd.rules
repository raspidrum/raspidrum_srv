// Allow members of the "audio" group to manage systemd units (start/stop general and transient units)
// copy to /usr/share/polkit-1/rules.d/
polkit.addRule(function(action, subject) {
  if (action.id.indexOf("org.freedesktop.systemd1.") === 0 && subject.isInGroup("audio")) {
    return polkit.Result.YES;
  }
});